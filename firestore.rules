rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados privados de cada usuário: só o dono lê e escreve.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil público (o link da bio): qualquer um LÊ, só o dono ESCREVE.
    // (usado quando construirmos a página pública /@usuario)
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
