{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**",
      "functions/**", "scripts/**", "_refs/**",
      "*.rules", "*.rules.json", "README.md"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
