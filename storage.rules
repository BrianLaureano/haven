rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de cada usuário: leitura pública (aparecem no perfil/story),
    // escrita só do dono.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
